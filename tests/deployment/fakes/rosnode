#!/usr/bin/env bash
# Test double for rosnode. Counts probes and succeeds or fails according to
# FAKE_ROSNODE_* variables. Used as the ROS-master readiness probe.
set -u

ev="${FAKE_EVENTS:-/dev/null}"

# Wait briefly for the fake roscore to announce itself so the ordering
# assertion does not depend on process scheduling.
marker="${ev}.roscore-started"
waited=0
while [ ! -e "$marker" ] && [ "$waited" -lt 100 ]; do
  sleep 0.02
  waited=$((waited + 1))
done

count_file="${FAKE_ROSNODE_COUNT_FILE:-${ev}.count}"

n=0
if [ -f "$count_file" ]; then
  n="$(cat "$count_file" 2>/dev/null || echo 0)"
fi
n=$((n + 1))
printf '%s\n' "$n" >"$count_file" 2>/dev/null || true

printf 'PROBE rosnode %s args=%s\n' "$n" "$*" >>"$ev" 2>/dev/null || true

if [ "${FAKE_ROSNODE_ALWAYS_FAIL:-0}" = "1" ]; then
  exit 1
fi
if [ -n "${FAKE_ROSNODE_SUCCEED_ON:-}" ] && [ "$n" -ge "${FAKE_ROSNODE_SUCCEED_ON}" ]; then
  exit 0
fi
exit 1
