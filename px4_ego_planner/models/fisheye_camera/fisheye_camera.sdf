<?xml version="1.0" ?>
<sdf version="1.6">
    <model name="fisheye_camera">
        <include>
            <uri>model://iris</uri>
        </include>

        <link name="fisheye_link">
            <pose>0.15 0 0.05 0 0 0</pose>
            <inertial>
                <mass>0.015</mass>
                <inertia>
                    <ixx>1e-05</ixx>
                    <iyy>1e-05</iyy>
                    <izz>1e-05</izz>
                </inertia>
            </inertial>

            <sensor name="fisheye_sensor" type="wideanglecamera">
                <update_rate>30</update_rate>
                <camera>
                    <horizontal_fov>3.1415</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>640</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>100</far>
                    </clip>
                    <lens>
                        <type>equidistant</type>
                        <scale_to_hfov>true</scale_to_hfov>
                        <cutoff_angle>1.5707</cutoff_angle>
                        <env_texture_size>512</env_texture_size>
                    </lens>
                </camera>
                <always_on>1</always_on>
                <visualize>true</visualize>

                <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <camera_name>fisheye</camera_name>
                    <image_topic_name>/fisheye/image_raw</image_topic_name>
                    <frame_name>fisheye_link</frame_name>
                </plugin>
            </sensor>
        </link>

        <joint name="fisheye_joint" type="fixed">
            <parent>iris::base_link</parent>
            <child>fisheye_link</child>
        </joint>

    </model>
</sdf>