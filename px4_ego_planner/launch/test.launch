<launch>
	<node name="real_mode_manager" pkg="px4_ego_planner" type="real_mode_manager" output="screen">
		<param name="point_num" value="3"/>
		<param name="point0_x" value="0.5"/>
		<param name="point0_y" value="0.5"/>
		<param name="point0_z" value="0.3"/>
		<param name="point1_x" value="-0.5"/>
		<param name="point1_y" value="-0.5"/>
		<param name="point1_z" value="0.3"/>
		<param name="point2_x" value="0.0"/>
		<param name="point2_y" value="0.0"/>
		<param name="point2_z" value="0.1"/>
	</node>
</launch>