<launch>
	<!-- parameters for simulator -->
	<arg name="world_path" default="$(find px4_ego_planner)/resource/sim_world/simple_obstacle.world" />
	<arg name="gui" default="false"/>
	<arg name="model" default="iris_360_depth_camera"/>

	<arg name="fcu_url" default="udp://:14540@localhost:14557"/>
	<arg name="gcs_url" default=""/>
	<arg name="tgt_system" default="1"/>
	<arg name="tgt_component" default="1" />
	<arg name="vehicle" default="quadrotor"/>

	<!-- Launch PX4 SITL -->
	<include file="$(find px4)/launch/px4.launch" />

	<!-- Launch MavROS -->
	<include file="$(find mavros)/launch/node.launch">
		<arg name="pluginlists_yaml" value="$(find px4_ego_planner)/config/px4_pluginlists.yaml" />
		<arg name="config_yaml" value="$(find px4_ego_planner)/config/px4_config.yaml" />
		<arg name="fcu_url" value="$(arg fcu_url)" />
		<arg name="gcs_url" value="$(arg gcs_url)" />
		<arg name="tgt_system" value="$(arg tgt_system)" />
		<arg name="tgt_component" value="$(arg tgt_component)" />
	</include>

	<!-- Launch Gazebo -->
	<include file="$(find gazebo_ros)/launch/empty_world.launch">
		<arg name="gui" value="$(arg gui)"/>
		<arg name="world_name" value="$(arg world_path)" />
	</include>

	<!-- Spawn vehicle model -->
	<!-- the vehilce value is just a name, it doesn't affect the system -->
	<node name="spawn_model" pkg="gazebo_ros" type="spawn_model" output="screen" args="-sdf -database $(arg model) -model $(arg vehicle)">
	</node>

	<!-- Define a static transform from a camera internal frame to the fcu for every camera used -->
	<node pkg="tf" type="static_transform_publisher" name="world_to_map" args="0 0 0 0 0 0 world map 10"/>
	<node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 map odom 10"/>

	<node pkg="tf" type="static_transform_publisher" name="tf_front" args="0.1 0 -0.03 0 0 0 base_link front_camera_link 100" />
	<node pkg="tf" type="static_transform_publisher" name="front_opt" args="0 0 0 -1.5708 0 -1.5708 front_camera_link front_camera_optical_frame 100" />

	<node pkg="tf" type="static_transform_publisher" name="tf_left" args="0 0.1 -0.03 1.5708 0 0 base_link left_camera_link 100" />
	<node pkg="tf" type="static_transform_publisher" name="left_opt" args="0 0 0 -1.5708 0 -1.5708 left_camera_link left_camera_optical_frame 100" />

	<node pkg="tf" type="static_transform_publisher" name="tf_right" args="0 -0.1 -0.03 -1.5708 0 0 base_link right_camera_link 100" />
	<node pkg="tf" type="static_transform_publisher" name="right_opt" args="0 0 0 -1.5708 0 -1.5708 right_camera_link right_camera_optical_frame 100" />

	<node pkg="tf" type="static_transform_publisher" name="tf_back" args="-0.1 0 -0.03 3.1415 0 0 base_link back_camera_link 100" />
	<node pkg="tf" type="static_transform_publisher" name="back_opt" args="0 0 0 -1.5708 0 -1.5708 back_camera_link back_camera_optical_frame 100" />

	<!-- Concat the Pointcloud -->
	<node pkg="px4_ego_planner" type="stable_tf_pub.py" name="stable_tf_pub" output="screen" />
	
	<include file="$(find pointcloud_concatenate)/launch/concat.launch">
		<arg name="hz" default="5" />
		<arg name="target_frame" default="base_link_stable" />
		<arg name="cloud_in1" default="/camera_front/depth/points" />
		<arg name="cloud_in2" default="/camera_left/depth/points" />
		<arg name="cloud_in3" default="/camera_right/depth/points" />
		<arg name="cloud_in4" default="/camera_back/depth/points" />
		<arg name="cloud_out" default="cloud_concatenated" />
	</include>

	<!-- Pointcloud to Laserscan -->
	<node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" name="cloud_to_scan">
		<remap from="cloud_in" to="/cloud_concatenated"/>
		<remap from="scan" to="/obstacles_laserscan"/>
		<param name="target_frame" value="base_link_stable"/>
		<param name="min_height" value="-0.5"/>
		<param name="max_height" value="0.5"/>
		<param name="angle_min" value="-3.14159265359"/>
		<param name="angle_max" value="3.14159265359"/>
		<param name="angle_increment" value="0.01745329"/>
		<param name="range_min" value="0.5"/>
		<param name="range_max" value="15.0"/>
		<param name="use_inf" value="true"/>
	</node>

	<node pkg="px4_ego_planner" type="scan_to_mavros.py" name="laser_to_mavros" output="screen"/>

	<!-- visualize robot in rviz -->
	<node name="visualization_node" pkg="px4_ego_planner" type="visualization_node"/>

	<node name="rviz" pkg="rviz" type="rviz" args="-d $(find px4_ego_planner)/resource/sim.rviz" required="true" />

</launch>
